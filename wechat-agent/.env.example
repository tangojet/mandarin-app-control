# wechat-agent — environment variables

# AT-SPI desktop agent URL inside the Docker container
# Default: http://localhost:55007
# DESKTOP_AGENT_URL=http://localhost:55007

# Request timeout for desktop agent calls (seconds)
# DESKTOP_REQUEST_TIMEOUT=15

# WeChat app name for AT-SPI filtering
# WECHAT_APP_NAME=wechat

# Server port (default: 8091)
# PORT=8091
