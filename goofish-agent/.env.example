# goofish-agent — environment variables

# Docker container name with a logged-in Chrome session for Goofish
# Default: goofish-browser
# GOOFISH_DOCKER_CONTAINER=goofish-browser

# Server port (default: 8090)
# PORT=8090

# Rate limit: minimum seconds between requests (default: 8)
# RATE_LIMIT_GOOFISH=8
